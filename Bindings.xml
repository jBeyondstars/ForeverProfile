<Bindings>
    <Binding name="FOREVERPROFILES_TOGGLE" header="FOREVERPROFILES">
        ForeverProfiles_Toggle();
    </Binding>
    <Binding name="FOREVERPROFILES_FAVORITE1">
        ForeverProfiles_ApplyFavorite(1);
    </Binding>
    <Binding name="FOREVERPROFILES_FAVORITE2">
        ForeverProfiles_ApplyFavorite(2);
    </Binding>
    <Binding name="FOREVERPROFILES_FAVORITE3">
        ForeverProfiles_ApplyFavorite(3);
    </Binding>
    <Binding name="FOREVERPROFILES_RESTORE">
        ForeverProfiles_Restore();
    </Binding>
</Bindings>
